# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API Keys) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable key" (sb_publishable_...). Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...). Server only. Bypasses RLS. Never expose.
SUPABASE_SECRET_KEY=

# --- Platform --------------------------------------------------------------
# Your brand name, shown on the platform pages.
NEXT_PUBLIC_PLATFORM_NAME=Cafe QR
# Host that serves the platform. Cafes live at <slug>.<PLATFORM_DOMAIN>, or at
# /c/<slug> on this host when there is no wildcard domain yet (free tier).
PLATFORM_DOMAIN=localhost:3000

# 32 random bytes, base64. Encrypts each cafe's Razorpay secret in the database.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# --- Demo cafe payments (Razorpay test mode) --------------------------------
DEMO_RAZORPAY_KEY_ID=
DEMO_RAZORPAY_KEY_SECRET=
# Webhook secret you set in Razorpay → Settings → Webhooks (events: payment.captured, payment.failed).
DEMO_RAZORPAY_WEBHOOK_SECRET=

# --- Scheduled job endpoints -------------------------------------------------
CRON_SECRET=

# --- Supabase CLI (supabase.com/dashboard/account/tokens) ----------------
# Lets the CLI push migrations without a browser login. Never commit.
SUPABASE_ACCESS_TOKEN=

# --- Staff logins ------------------------------------------------------------
# Staff sign in with a username; it maps to <username>.<cafe>@<this domain>.
# Use a domain you own in production (no mail is ever sent to it).
STAFF_EMAIL_DOMAIN=staff.example.com
